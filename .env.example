OLLAMA_HOST=http://10.5.1.20:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_MODEL_DEEP=gemma4:12b

# --- Advanced Ollama tuning (optional — sensible defaults, uncomment to override) ---
# Context window sent with every request (tokens). Ollama silently truncates
# input above this with no error, which can produce empty/garbled replies as
# the system prompt + conversation history grow. Raise if you add a lot more
# personality/tool/memory prompt text; lower if VRAM is tight.
# LAIN_OLLAMA_NUM_CTX=16384
# How long to wait for Ollama before failing cleanly with an error message
# (ms). Useful if the LLM host is sometimes slow to load/swap models.
# LAIN_OLLAMA_TIMEOUT_MS=90000
# How many past messages to include as conversation history per request.
# LAIN_HISTORY_LIMIT=40

# Host port on the server that Lain listens on (change if 3000 is taken)
LAIN_HOST_PORT=7869

# --- Authentication (Auth.js) ---
# Generate with: npx auth secret
AUTH_SECRET=
AUTH_URL=https://lain.dialtone.cc

# GitHub OAuth App (github.com/settings/developers)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google OAuth Client (console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated allowlist: GitHub usernames and/or Google emails
ALLOWED_USERS=xbikr2@gmail.com,sketch0395

# --- CLI access ---
# Optional bearer token that lets trusted local tools (e.g. the `lain` CLI)
# call the API without going through OAuth. Leave blank to disable.
# Generate with: openssl rand -hex 32
LAIN_API_TOKEN=

# --- Tools agent (let Lain check diagnostics/files/Omarchy on your laptop) ---
# Set up the agent on your laptop with scripts/setup-tools-agent.sh, then
# copy the URL/token it prints here. Leave both blank to disable tool use
# entirely (Lain just won't offer to use tools).
LAIN_TOOLS_URL=http://10.5.1.20:8787
LAIN_TOOLS_TOKEN=

# --- Reminders / notifications ---
# Timezone used to interpret reminder times ("in 30 minutes", "every day at
# 9am", etc). Must be a valid IANA timezone name.
LAIN_TIMEZONE=America/Chicago

# Optional: RSS feed used by the "news" reminder action / get_news tool.
# LAIN_NEWS_FEED_URL=https://feeds.bbci.co.uk/news/rss.xml

# Browser push notifications for reminders (works even without the tools
# agent, e.g. on a phone). Generate a keypair once with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Leave blank to disable browser push (desktop notifications via the tools
# agent still work independently of this).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional: email reminders via SMTP. Works independently of the tools
# agent/browser push — just needs a mailbox. Leave SMTP_HOST blank to
# disable. For Gmail: smtp.gmail.com, port 587, and an App Password
# (not your normal password) as SMTP_PASS.
SMTP_HOST=
SMTP_PORT=587
# SMTP_SECURE=true   # set true if using port 465 (implicit TLS)
SMTP_USER=
SMTP_PASS=
# Defaults to SMTP_USER if unset
SMTP_FROM=
# Where reminder emails are sent
LAIN_REMINDER_EMAIL_TO=

# Optional: PIN required to wipe all remembered facts (Settings → 🗑️ Wipe
# All Memory, or the chat command "I couldn't protect you"). Defaults to
# 0395 if unset.
# LAIN_WIPE_PIN=0395
